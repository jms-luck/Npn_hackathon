DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-unique-password

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5.1
LLM_EXPLANATIONS_PER_MATCH=10
GITHUB_EVALUATIONS_PER_MATCH=50
GITHUB_TOKEN=

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_JOB_COLLECTION=job_embeddings
QDRANT_RESUME_COLLECTION=resume_embeddings
EMBEDDING_DIMENSION=3072

LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=60
CACHE_JOB_TTL=30
CACHE_COMPANY_TTL=300
CACHE_PROFILE_TTL=60

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hireai-graph-2026
CACHE_GRAPH_TTL=300

VITE_API_URL=/api

# Single-container startup checks external Qdrant/Neo4j counts. Keep automatic
# seeding disabled unless deployment startup may incur long Azure embedding runs.
AUTO_SEED_EXTERNAL_INDEXES=false
SKIP_EXTERNAL_INDEX_CHECK=false
FRONTEND_DIST_DIR=./frontend_dist
APP_PORT=8080

# compose.single.yaml defaults to these local Docker-host endpoints. Override
# them with managed/external service URLs in cloud deployments.
SINGLE_QDRANT_URL=http://host.docker.internal:6333
SINGLE_NEO4J_URI=bolt://host.docker.internal:7687
SINGLE_REDIS_URL=redis://host.docker.internal:6379/0